# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=loomtale
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loomtale
DATABASE_URL=postgres://loomtale:change-me@postgres:5432/loomtale?sslmode=disable

# --- MinIO (root creds live in secrets/*.txt via compose secrets, not here) ---
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=loomtale
MINIO_REGION=us-east-1
# App-scoped key created by minio-init; populated in .env by the operator after first `docker compose up`.
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=

# --- API ---
API_ADDR=:8080
API_LOG_LEVEL=info
API_SHUTDOWN_TIMEOUT=25s

# --- Web ---
VITE_API_BASE_URL=http://127.0.0.1:8080
