# Copy to .env and fill in real values. Never commit .env.
# `bash scripts/dev-secrets-init.sh` generates every value below (and the
# matching secrets/*.txt files) for local dev in one shot.

# --- Postgres ---
POSTGRES_USER=loomtale
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loomtale
DATABASE_URL=postgres://loomtale:change-me@postgres:5432/loomtale?sslmode=disable
# loomtale_owner/loomtale_app role passwords: must match secrets/postgres_owner_password.txt
# and secrets/postgres_app_password.txt exactly (those files are what
# deploy/postgres/init-roles.sh uses to create the roles on first boot).
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=

# --- MinIO (root creds live in secrets/*.txt via compose secrets, not here) ---
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=loomtale
MINIO_REGION=us-east-1
# App-scoped key: chosen by the operator up front (not generated at
# runtime), so a fresh `docker compose up --wait` needs no manual step.
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=

# --- API ---
API_ADDR=:8080
API_LOG_LEVEL=info
API_SHUTDOWN_TIMEOUT=25s
# Comma-separated Origin allowlist for CSRF; the SPA's own origin.
WEB_ORIGIN=http://127.0.0.1:8080
# https URL turns on HSTS; leave empty for local http dev.
PUBLIC_URL=
# External media CDN origin, if any, interpolated into the CSP.
MEDIA_ORIGIN=

# --- Backup (deploy/backup/backup.sh; secrets/backup_*.txt hold the keys) ---
# Encrypted cloud bucket target, e.g. an rclone-style remote for R2/B2.
BACKUP_TARGET=

# --- Web ---
VITE_API_BASE_URL=http://127.0.0.1:8080
