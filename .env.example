# Copy to .env and fill in real values. Never commit .env.
# `bash scripts/dev-secrets-init.sh` generates every value below (and the
# matching secrets/*.txt files) for local dev in one shot.

# --- Postgres ---
# The bootstrap superuser's password lives only in secrets/postgres_superuser_password.txt
# (mounted via POSTGRES_PASSWORD_FILE) — no .env var for it, and no
# container connects as this user after first boot;
# deploy/postgres/init-roles.sh uses it once to create the roles below.
POSTGRES_USER=loomtale
POSTGRES_DB=loomtale
# loomtale_owner/loomtale_app/loomtale_backup role passwords: must match
# secrets/postgres_owner_password.txt, secrets/postgres_app_password.txt
# and secrets/postgres_backup_password.txt exactly (those files are what
# deploy/postgres/init-roles.sh uses to create the roles on first boot).
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_BACKUP_PASSWORD=

# --- MinIO (root creds live in secrets/*.txt via compose secrets, not here) ---
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=loomtale
MINIO_REGION=us-east-1
# App-scoped (read-write) key: chosen by the operator up front (not
# generated at runtime), so a fresh `docker compose up --wait` needs no
# manual step.
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
# Backup-scoped (read-only: GetObject/ListBucket) key for the backup
# sidecar, separate from the app key and never the root credentials.
MINIO_BACKUP_ACCESS_KEY=
MINIO_BACKUP_SECRET_KEY=

# --- API ---
API_ADDR=:8080
API_LOG_LEVEL=info
API_SHUTDOWN_TIMEOUT=25s
# Comma-separated Origin allowlist for CSRF; the SPA's own origin. 127.0.0.1
# (like localhost) is a secure context in Chrome and Firefox per the W3C
# Secure Contexts spec, so __Host-/Secure cookies work over plain http here.
WEB_ORIGIN=http://127.0.0.1:8080
# https URL turns on HSTS; leave empty for local http dev.
PUBLIC_URL=
# Media origin interpolated into the CSP (presigned MinIO uploads/downloads).
# Empty uses MinIO's published http://127.0.0.1:9000; set it to your CDN or
# public MinIO origin in other deployments.
MEDIA_ORIGIN=

# --- YouTube (Google OAuth client for connecting channels) ---
# Empty GOOGLE_CLIENT_ID leaves connecting disabled (Settings > YouTube says
# so). Create a "Web application" OAuth client in Google Cloud with the
# YouTube Data API v3 enabled and register GOOGLE_OAUTH_REDIRECT_URL on it
# exactly. The client secret is never put here: write it to a file, mount
# it into the api container (e.g. a compose override adding a secret from
# secrets/google_client_secret.txt) and point GOOGLE_CLIENT_SECRET_PATH at
# the mounted path (e.g. /run/secrets/google_client_secret). While the
# consent screen is in "testing" mode Google expires refresh tokens after
# 7 days: publish the consent screen for lasting connections.
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URL=http://127.0.0.1:8080/api/v1/channels/oauth/callback
GOOGLE_CLIENT_SECRET_PATH=
# Data API quota ledger. Costs stay conservative (insert 1600) until a live
# upload has been checked against the Cloud console quota page.
YOUTUBE_QUOTA_PROJECT=default
YOUTUBE_QUOTA_DAILY_LIMIT=10000
YOUTUBE_QUOTA_COST_INSERT=1600

# --- Backup (deploy/backup/backup.sh; secrets/backup_*.txt hold the keys) ---
# Encrypted cloud bucket target endpoint (e.g. an R2/B2 S3-compatible
# endpoint URL) and the bucket name within it that backup.sh writes
# postgres/ and objects/ prefixes under.
BACKUP_TARGET=
BACKUP_TARGET_BUCKET=
# The age *public* recipient only (never the private identity, which
# scripts/dev-secrets-init.sh writes to secrets/backup_encryption_key.txt
# for the operator to keep offline — it is not read from .env and not
# mounted into any container).
BACKUP_ENCRYPTION_RECIPIENT=

# --- Web ---
VITE_API_BASE_URL=http://127.0.0.1:8080

# --- Model downloads (deploy/compose.gpu.yml) ---
# Host directory bind-mounted read-only into the worker and the operator
# CLI so the download pre-flight reads the real free space of the drive
# holding Docker's data disk (on Docker Desktop the models volume only
# reports its virtual disk's maximum size). Empty uses deploy/host-disk;
# set it when Docker's data disk is on another drive than this checkout.
MODELS_HOST_DISK_SOURCE=

# Render and model-pull enqueues are refused below DISK_MIN_FREE_GB free
# (on Docker's data disk and on the drive above), with a warning chip
# below DISK_WARN_FREE_GB.
DISK_MIN_FREE_GB=40
DISK_WARN_FREE_GB=60

# --- Local engines (deploy/compose.gpu.yml) ---
# Engine runtimes built into the Python worker image, space-separated:
# "tts-en tts-vi align" for a GPU deployment. tts-en and align add the
# CUDA 12.8 PyTorch wheels (several GB); empty builds the small image in
# which every engine answers engine_not_installed.
PYWORKER_EXTRAS=
# The local LLM the worker loads in Ollama: a manifest entry name
# (models/manifest.yaml, engine ollama), e.g. qwen3.5-9b or gemma-4-12b.
# It is imported offline from its pinned GGUF on first load. Empty keeps
# Ollama unconfigured.
OLLAMA_MODEL=
