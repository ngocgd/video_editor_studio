:8080 {
	encode gzip

	# CSP per the approved plan decision: self-only scripts, inline styles
	# allowed (Tailwind/shadcn), Trusted Types enforced, no plugin objects.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; require-trusted-types-for 'script'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# `route` preserves the written order below. Without it, Caddy's default
	# directive sort runs `try_files` before `reverse_proxy`, so it rewrites
	# any non-static path (including /api/v1/healthz) to /index.html before
	# the proxy matcher ever sees the original path.
	route {
		# A trailing `*` as the final path segment is Caddy's greedy form
		# and matches the rest of the path across additional slashes (unlike
		# a `*` elsewhere, which only matches within one segment). `**` is
		# not special syntax here and only matched a single segment.
		reverse_proxy /api/* api:8080

		root * /srv
		try_files {path} /index.html
		file_server
	}
}
