:8080 {
	# `handle` blocks are mutually exclusive and match top to bottom, so
	# /api/* responses carry only the API's own security headers
	# (api/internal/secheaders) unmodified, and static SPA responses carry
	# only Caddy's copy below. Stacking both sets of headers on the same
	# response (the previous `header` + `route`/reverse_proxy shape did
	# this) is invalid: a client seeing two Content-Security-Policy
	# headers must enforce the most restrictive of an ambiguous set,
	# which is not what either side intended.
	handle /api/* {
		# Matches api/internal/httpx.MaxBodyBytes: reject an oversized body
		# here too, before it is even proxied, not just at the API.
		request_body {
			max_size 256KB
		}
		# No `encode gzip` on this block: gzip buffers output until its
		# window fills or the stream ends, which would turn
		# /api/v1/events (text/event-stream, api/internal/pipelineapi
		# StreamEvents) into a stream a browser's EventSource never
		# receives incrementally. flush_interval -1 makes every proxied
		# write reach the client immediately instead of waiting on Go's
		# reverse proxy's own buffering heuristics, which is what an SSE
		# response needs and a normal JSON response is unaffected by.
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle {
		encode gzip

		# Enforcing CSP, never Report-Only. {$MEDIA_ORIGIN} is the same env
		# var the API reads for its own copy of this header
		# (api/internal/secheaders), so both always send byte-identical
		# values on their own responses.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; img-src 'self' blob: data: {$MEDIA_ORIGIN}; media-src 'self' blob: {$MEDIA_ORIGIN}; connect-src 'self' {$MEDIA_ORIGIN}; font-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; require-trusted-types-for 'script'; trusted-types default dompurify"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}

		# Vite fingerprints every /assets/* file name with a content hash, so
		# it is safe (and correct, for the SPA's own perf budget) to cache
		# those responses as immutable for a year; index.html itself is
		# never matched here (it falls through to try_files below) and so
		# keeps Caddy's normal, non-cached response.
		@immutableAssets path /assets/*
		header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

		root * /srv
		try_files {path} /index.html
		file_server
	}
}
